rules_version = '2';

// Every document lives under users/{uid}; a signed-in user can only touch their own subtree.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      // Accounts are soft-deleted (flag), never removed by the client.
      allow delete: if false;

      match /medicalRecords/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200;
      }

      match /basicInformation/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.kind in ['allergy', 'condition']
          && request.resource.data.active is bool;
      }

      match /medicines/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.medication is string
          && request.resource.data.medication.size() > 0
          && request.resource.data.medication.size() <= 200
          && request.resource.data.frequency is int
          && request.resource.data.frequency >= 1
          && request.resource.data.frequency <= 4
          && request.resource.data.active is bool;
      }

      match /appointments/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['scheduled', 'completed']
          && request.resource.data.startDate is timestamp
          && request.resource.data.endDate is timestamp
          && request.resource.data.endDate > request.resource.data.startDate;
      }

      match /settings/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.notificationsEnabled is bool
          && request.resource.data.medicineReminders is bool
          && request.resource.data.appointmentReminders is bool
          && request.resource.data.appearance in ['system', 'light', 'dark'];
        allow delete: if isOwner(userId);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
